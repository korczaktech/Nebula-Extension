{
  "Variável": {
    "prefix": "variavel",
    "body": "variavel ${1:nome}: ${2:tipo} = ${3:valor}",
    "description": "Declara variável mutável com tipo explícito ou inferido."
  },
  "Constante": {
    "prefix": "constante",
    "body": "constante ${1:NOME}: ${2:tipo} = ${3:valor}",
    "description": "Declara constante que não pode ser reatribuída."
  },
  "Função": {
    "prefix": "funcao",
    "body": [
      "funcao ${1:nome}(${2:parametros}) -> ${3:tipo}: {",
      "    ${4:passar}",
      "    fim",
      "} fim"
    ],
    "description": "Declara função com Function Body, fim interno e fim externo."
  },
  "Função pública": {
    "prefix": "funcaop",
    "body": [
      "publico funcao ${1:nome}(${2:parametros}) -> ${3:tipo}: {",
      "    ${4:passar}",
      "    fim",
      "} fim"
    ],
    "description": "Declara função pública."
  },
  "Função assíncrona": {
    "prefix": "asyncfuncao",
    "body": [
      "async funcao ${1:nome}(${2:parametros}): {",
      "    ${3:variavel resultado = aguarda operacao()}",
      "    fim",
      "} fim"
    ],
    "description": "Declara função assíncrona."
  },
  "Condicional se": {
    "prefix": "se",
    "body": [
      "se ${1:condicao}: {",
      "    ${2:passar}",
      "    fim",
      "} fim"
    ],
    "description": "Executa bloco quando a condição é verdadeira."
  },
  "Condição sendo": {
    "prefix": "sendo",
    "body": [
      "sendo ${1:condicao}: {",
      "    ${2:passar}",
      "    fim",
      "}"
    ],
    "description": "Adiciona uma condição alternativa à cadeia se/sendo/senao."
  },
  "Alternativa senao": {
    "prefix": "senao",
    "body": [
      "senao: {",
      "    ${1:passar}",
      "    fim",
      "}"
    ],
    "description": "Executa quando nenhuma condição anterior é satisfeita."
  },
  "Escolha": {
    "prefix": "escolha",
    "body": [
      "escolha ${1:valor}: {",
      "    caso ${2:1}: {",
      "        ${3:passar}",
      "        fim",
      "    }",
      "    padrao: {",
      "        ${4:passar}",
      "        fim",
      "    }",
      "    fim",
      "} fim"
    ],
    "description": "Seleciona uma alternativa com caso e padrao."
  },
  "Caso": {
    "prefix": "caso",
    "body": [
      "caso ${1:valor}: {",
      "    ${2:passar}",
      "    fim",
      "}"
    ],
    "description": "Cria um braço caso dentro de escolha."
  },
  "Laço para": {
    "prefix": "para",
    "body": [
      "para ${1:item} dentro ${2:faixa(0, 10)}: {",
      "    ${3:exibir(item)}",
      "    fim",
      "} fim"
    ],
    "description": "Percorre uma sequência com para/dentro."
  },
  "Laço enquanto": {
    "prefix": "enquanto",
    "body": [
      "enquanto ${1:condicao}: {",
      "    ${2:passar}",
      "    fim",
      "} fim"
    ],
    "description": "Repete enquanto a condição for verdadeira."
  },
  "Tratamento de erros": {
    "prefix": "tente",
    "body": [
      "tente: {",
      "    ${1:passar}",
      "    fim",
      "}",
      "erro ${2:ErroEsperado}: {",
      "    ${3:exibir(\"Falha\") }",
      "    fim",
      "}",
      "sempre: {",
      "    ${4:passar}",
      "    fim",
      "}",
      "fim"
    ],
    "description": "Monta tratamento com tente, erro e sempre."
  },
  "Lançar erro": {
    "prefix": "lancar",
    "body": "lancar erro ${1:\"Operacao invalida\"}",
    "description": "Lança um erro."
  },
  "Verificação": {
    "prefix": "verifique",
    "body": "verifique ${1:condicao}, ${2:\"Mensagem de erro\"}",
    "description": "Verifica uma condição."
  },
  "Retornar": {
    "prefix": "retorne",
    "body": "retorne ${1:valor}",
    "description": "Encerra função e devolve um valor."
  },
  "Interromper laço": {
    "prefix": "pare",
    "body": "pare",
    "description": "Interrompe o laço atual."
  },
  "Próxima iteração": {
    "prefix": "prossiga",
    "body": "prossiga",
    "description": "Pula para a próxima iteração."
  },
  "Instrução vazia": {
    "prefix": "passar",
    "body": "passar",
    "description": "Instrução sem operação."
  },
  "Importar biblioteca": {
    "prefix": "incluir",
    "body": "incluir(biblioteca: ${1:sistema})",
    "description": "Importa uma biblioteca pela forma canônica."
  },
  "Importar módulo": {
    "prefix": "incluirmodulo",
    "body": "incluir(modulo: ${1:arquivos}, biblioteca: ${2:sistema})",
    "description": "Importa módulo de uma biblioteca."
  },
  "Importar com apelido": {
    "prefix": "incluircomo",
    "body": "incluir(biblioteca: ${1:matematica}) como ${2:mat}",
    "description": "Importa biblioteca e cria apelido."
  },
  "Classe": {
    "prefix": "classe",
    "body": [
      "classe ${1:Nome}: {",
      "    funcao construtor(${2:parametros}): {",
      "        ${3:passar}",
      "        fim",
      "    } fim",
      "    fim",
      "} fim"
    ],
    "description": "Declara classe com corpo estrutural."
  },
  "Exportar função": {
    "prefix": "exportarfuncao",
    "body": [
      "exportar funcao ${1:nome}(${2:parametros}): {",
      "    retorne ${3:valor}",
      "    fim",
      "} fim"
    ],
    "description": "Exporta uma função."
  },
  "Função lambda": {
    "prefix": "lambda",
    "body": "variavel ${1:nome} = lambda ${2:parametro}: ${3:expressao}",
    "description": "Cria uma função anônima."
  },
  "Função de seta": {
    "prefix": "seta",
    "body": "variavel ${1:nome} = (${2:parametros}) -> ${3:expressao}",
    "description": "Cria uma função de seta."
  },
  "Objeto": {
    "prefix": [
      "objetos",
      "objeto"
    ],
    "body": [
      "objetos ${1:Nome}: {",
      "    ${2:campo}: ${3:tipo}",
      "    fim",
      "} fim"
    ],
    "description": "Declara bloco estrutural de objetos conforme a sintaxe complementar."
  },
  "Dicionário": {
    "prefix": "dicionarios",
    "body": [
      "dicionarios ${1:Nome}: {",
      "    ${2:chave}: ${3:valor}",
      "    fim",
      "} fim"
    ],
    "description": "Declara bloco estrutural de dicionários."
  },
  "Tipo estruturado": {
    "prefix": "estrutura",
    "body": [
      "estrutura ${1:Cabecalho}: {",
      "    codigo: u32",
      "    tamanho: u16",
      "    fim",
      "} fim"
    ],
    "description": "Exemplo de estrutura da camada Nebula Nativo; confirme suporte no compilador."
  },
  "Enumeração": {
    "prefix": "enumeracao",
    "body": [
      "enumeracao ${1:Estado}: {",
      "    ${2:Ativo}",
      "    ${3:Inativo}",
      "    fim",
      "} fim"
    ],
    "description": "Declara enumeração; confirme suporte no compilador."
  },
  "Variável com tipo genérico": {
    "prefix": "generico",
    "body": "variavel ${1:itens}: vetor<${2:u8}> = ${3:valor}",
    "description": "Exemplo de tipo genérico."
  },
  "Memória reservar": {
    "prefix": "memreservar",
    "body": "variavel ${1:regiao} = memoria.reservar(${2:tamanho}, ${3:alinhamento})",
    "description": "Reserva região de memória; API de baixo nível."
  },
  "Memória alocar": {
    "prefix": "memalocar",
    "body": "variavel ${1:itens} = memoria.alocar<${2:u8}>(${3:quantidade})",
    "description": "Aloca elementos tipados."
  },
  "Memória escrever": {
    "prefix": "memescrever",
    "body": "memoria.escrever<${1:u32}>(${2:regiao}, ${3:deslocamento}, ${4:valor})",
    "description": "Escreve valor em região de memória."
  },
  "Memória ler": {
    "prefix": "memler",
    "body": "variavel ${1:valor} = memoria.ler<${2:u32}>(${3:regiao}, ${4:deslocamento})",
    "description": "Lê valor de região de memória."
  },
  "Operação de bits": {
    "prefix": "bitsdefinir",
    "body": "variavel ${1:estado} = bits.definir(${2:valor}, ${3:indice})",
    "description": "Define um bit."
  },
  "Privilégio": {
    "prefix": "privilegio",
    "body": [
      "privilegio sistema: {",
      "    ${1:cpu.interrupcoes.desabilitar()}",
      "    fim",
      "} fim"
    ],
    "description": "Abre bloco privilegiado; exige perfil e permissões compatíveis."
  },
  "Bloco crítico": {
    "prefix": "critico",
    "body": [
      "critico: {",
      "    ${1:passar}",
      "    fim",
      "} fim"
    ],
    "description": "Abre região crítica."
  },
  "Assembly embutido": {
    "prefix": "montagem",
    "body": "variavel ${1:resultado} = montagem ${2:x86_64}<${3:u64}>(entradas: [${4:10}], saidas: [${5:registrador.rax}], efeitos: [${6:registradores}], instrucoes: [${7:\"nop\"}])",
    "description": "Expressão de Assembly com arquitetura, tipos, entradas, saídas e efeitos."
  },
  "Exibir": {
    "prefix": "exibir",
    "body": "exibir(${1:valor})",
    "description": "Exibe valor."
  },
  "Ler texto": {
    "prefix": "lerTexto",
    "body": "variavel ${1:texto} = lerTexto(${2:\"Mensagem: \"})",
    "description": "Lê texto do usuário."
  },
  "Faixa": {
    "prefix": "faixa",
    "body": "faixa(${1:inicio}, ${2:fim})",
    "description": "Gera sequência numérica."
  },
  "Nova linha de arquivo": {
    "prefix": "lerArquivo",
    "body": [
      "variavel ${1:arquivo} = abrir(${2:\"dados.txt\"}, ${3:\"leitura\"})",
      "variavel ${4:conteudo} = ler(${1:arquivo})",
      "fechar(${1:arquivo})"
    ],
    "description": "Abre, lê e fecha um arquivo."
  },
  "Async aguarda": {
    "prefix": "aguarda",
    "body": "variavel ${1:resultado} = aguarda ${2:operacaoAssincrona}()",
    "description": "Aguarda operação assíncrona."
  },
  "Registrador CPU": {
    "prefix": "cpuregistro",
    "body": "variavel ${1:valor} = cpu.registro.ler(${2:cpu.registro.rax})",
    "description": "Exemplo de leitura de registrador; depende de arquitetura e privilégio."
  },
  "Porta de I/O": {
    "prefix": "portaler",
    "body": "variavel ${1:valor} = porta.ler${2:8}(${3:0x60})",
    "description": "Lê porta de I/O; disponível apenas em alvos compatíveis."
  },
  "Registrar interrupção": {
    "prefix": "interrupcao",
    "body": "interrupcao.registrar(${1:33}, ${2:tratarInterrupcao})",
    "description": "Registra manipulador de interrupção."
  },
  "Transferência DMA": {
    "prefix": "dma",
    "body": "variavel ${1:transferencia} = dma.criar(${2:configuracao})",
    "description": "Prepara transferência DMA."
  },
  "Operação atômica": {
    "prefix": "atomico",
    "body": "atomico.somar(${1:contador}, ${2:1}, ordem: ${3:relaxado})",
    "description": "Soma atomicamente."
  }
}
