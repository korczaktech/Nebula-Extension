{
  "Variável": {
    "prefix": [
      "variavel",
      "var"
    ],
    "body": [
      "variavel ${1:nome}: ${2:tipo} = ${3:valor}"
    ],
    "description": "Declara uma variável tipada"
  },
  "Variável mutável": {
    "prefix": [
      "mutavel",
      "mutável"
    ],
    "body": [
      "mutavel ${1:nome}: ${2:tipo} = ${3:valor}"
    ],
    "description": "Declara uma variável mutável"
  },
  "Constante": {
    "prefix": "constante",
    "body": [
      "constante ${1:NOME}: ${2:tipo} = ${3:valor}"
    ],
    "description": "Declara uma constante"
  },
  "Definir valor": {
    "prefix": "definir",
    "body": [
      "definir ${1:nome} = ${2:valor}"
    ],
    "description": "Define um valor"
  },
  "Alterar valor": {
    "prefix": "alterar",
    "body": [
      "alterar ${1:nome} <- ${2:valor}"
    ],
    "description": "Altera um valor"
  },
  "Função": {
    "prefix": [
      "funcao",
      "função",
      "fn"
    ],
    "body": [
      "funcao ${1:nome}(${2:parametros}): ${3:vazio} {",
      "\t${0}",
      "}"
    ],
    "description": "Declara uma função"
  },
  "Função pública": {
    "prefix": "funcaop",
    "body": [
      "publico funcao ${1:nome}(${2:parametros}): ${3:vazio} {",
      "\t${0}",
      "}"
    ],
    "description": "Declara uma função pública"
  },
  "Quando": {
    "prefix": "quando",
    "body": [
      "quando ${1:condicao} {",
      "\t${0}",
      "}"
    ],
    "description": "Estrutura condicional"
  },
  "Quando e senão": {
    "prefix": "quandosen",
    "body": [
      "quando ${1:condicao} {",
      "\t${2}",
      "} senao {",
      "\t${0}",
      "}"
    ],
    "description": "Estrutura condicional com alternativa"
  },
  "Senão se": {
    "prefix": "senaose",
    "body": [
      "senao quando ${1:condicao} {",
      "\t${0}",
      "}"
    ],
    "description": "Condição alternativa"
  },
  "Escolha": {
    "prefix": "escolha",
    "body": [
      "escolha ${1:valor} {",
      "\tcaso ${2:Tipo::Variante} {",
      "\t\t${3}",
      "\t}",
      "\tcaso _ {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Correspondência de padrões"
  },
  "Caso": {
    "prefix": "caso",
    "body": [
      "caso ${1:padrao} {",
      "\t${0}",
      "}"
    ],
    "description": "Braço de correspondência"
  },
  "Enquanto": {
    "prefix": "enquanto",
    "body": [
      "enquanto ${1:condicao} {",
      "\t${0}",
      "}"
    ],
    "description": "Laço enquanto"
  },
  "Durante": {
    "prefix": "durante",
    "body": [
      "durante ${1:condicao} {",
      "\t${0}",
      "}"
    ],
    "description": "Laço durante"
  },
  "Repetir": {
    "prefix": "repetir",
    "body": [
      "repetir ${1:condicao} {",
      "\t${0}",
      "}"
    ],
    "description": "Laço de repetição"
  },
  "Cada elemento": {
    "prefix": "cada",
    "body": [
      "cada ${1:item} em ${2:colecao} {",
      "\t${0}",
      "}"
    ],
    "description": "Percorre os elementos de uma coleção"
  },
  "Para": {
    "prefix": "para",
    "body": [
      "para(${1:indice} = ${2:0}; ${1} < ${3:limite}; ${1} = ${1} + 1) {",
      "\t${0}",
      "}"
    ],
    "description": "Laço com inicialização, condição e incremento"
  },
  "Pulso": {
    "prefix": "pulso",
    "body": [
      "pulso(${1:intervalo}) {",
      "\t${0}",
      "}"
    ],
    "description": "Bloco periódico"
  },
  "Função terminada em fim": {
    "prefix": "funcaofim",
    "body": [
      "funcao ${1:nome}(${2:parametros}): ${3:vazio}",
      "\t${0}",
      "fim"
    ],
    "description": "Declara função com terminador fim"
  },
  "Quando terminado em fim": {
    "prefix": "quandofim",
    "body": [
      "quando ${1:condicao}",
      "\t${0}",
      "fim"
    ],
    "description": "Condicional com terminador fim"
  },
  "Enquanto terminado em fim": {
    "prefix": "enquantofim",
    "body": [
      "enquanto ${1:condicao}",
      "\t${0}",
      "fim"
    ],
    "description": "Laço com terminador fim"
  },
  "Estrutura": {
    "prefix": "estrutura",
    "body": [
      "estrutura ${1:Nome} {",
      "\t${2:campo}: ${3:tipo}",
      "\t${0}",
      "}"
    ],
    "description": "Declara uma estrutura"
  },
  "Enumeração": {
    "prefix": [
      "enumeracao",
      "enumeração"
    ],
    "body": [
      "enumeracao ${1:Nome} {",
      "\t${2:PrimeiraVariante},",
      "\t${0:SegundaVariante}",
      "}"
    ],
    "description": "Declara uma enumeração"
  },
  "Alias de tipo": {
    "prefix": "tipo",
    "body": [
      "tipo ${1:Nome} = ${2:TipoBase}"
    ],
    "description": "Define um alias de tipo"
  },
  "Incluir módulo": {
    "prefix": "incluir",
    "body": [
      "incluir ${1:sistema::texto} como ${2:apelido}"
    ],
    "description": "Importa um módulo"
  },
  "Retornar": {
    "prefix": "devolver",
    "body": [
      "devolver ${1:valor}"
    ],
    "description": "Retorna um valor"
  },
  "Exibir": {
    "prefix": "exibir",
    "body": [
      "exibir(${1:valor})"
    ],
    "description": "Exibe um valor"
  },
  "Receber": {
    "prefix": "receber",
    "body": [
      "receber(${1:mensagem})"
    ],
    "description": "Recebe uma entrada"
  },
  "Perguntar": {
    "prefix": "perguntar",
    "body": [
      "perguntar(${1:mensagem})"
    ],
    "description": "Solicita uma entrada"
  },
  "Vetor": {
    "prefix": "vetor",
    "body": [
      "vetor<${1:tipo}>"
    ],
    "description": "Modelo de tipo vetor"
  },
  "Resultado": {
    "prefix": "resultado",
    "body": [
      "Resultado<${1:Sucesso}, ${2:Erro}>"
    ],
    "description": "Tipo de resultado"
  },
  "Avaliar": {
    "prefix": "avaliar",
    "body": [
      "avaliar ${1:valor} {",
      "\tcaso ${2:Tipo::Variante} {",
      "\t\t${3}",
      "\t}",
      "\tcaso _ {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Correspondência de padrões"
  },
  "Lista": {
    "prefix": "lista",
    "body": [
      "[${1:tipo}]"
    ],
    "description": "Tipo de lista homogênea"
  },
  "Matriz": {
    "prefix": "matriz",
    "body": [
      "matriz<${1:tipo}>"
    ],
    "description": "Tipo de matriz homogênea"
  },
  "Tupla": {
    "prefix": "tupla",
    "body": [
      "Tupla<${1:TipoA}, ${2:TipoB}>"
    ],
    "description": "Tipo de tupla"
  },
  "Opcional": {
    "prefix": "opcional",
    "body": [
      "Opcional<${1:tipo}>"
    ],
    "description": "Tipo opcional"
  },
  "Leitura de texto": {
    "prefix": "lertexto",
    "body": [
      "ler_texto()"
    ],
    "description": "Lê uma linha de texto"
  },
  "Aguardar": {
    "prefix": "aguardar",
    "body": [
      "aguardar(${1:milissegundos})"
    ],
    "description": "Aguarda um intervalo"
  },
  "Dormir": {
    "prefix": "dormir",
    "body": [
      "dormir(${1:milissegundos})"
    ],
    "description": "Suspende a execução"
  },
  "Gerar coleção": {
    "prefix": "gerar",
    "body": [
      "gerar(${1:valor}, ${2:quantidade})"
    ],
    "description": "Gera uma coleção com valores repetidos"
  },
  "Executar em paralelo": {
    "prefix": "emparalelo",
    "body": [
      "em_paralelo(${1:funcao1}, ${2:funcao2})"
    ],
    "description": "Executa funções em paralelo"
  },
  "Parar": {
    "prefix": "parar",
    "body": [
      "parar"
    ],
    "description": "Interrompe o laço atual"
  },
  "Encerrar": {
    "prefix": "encerrar",
    "body": [
      "encerrar"
    ],
    "description": "Alias para parar"
  },
  "Seguir": {
    "prefix": "seguir",
    "body": [
      "seguir"
    ],
    "description": "Avança para a próxima iteração"
  },
  "Função genérica": {
    "prefix": "funcaogen",
    "body": [
      "funcao ${1:nome}<${2:T}>(${3:valor}: ${2:T}): ${2:T} {",
      "\t${0}",
      "}"
    ],
    "description": "Declara uma função genérica"
  }
}
