{
  "scopeName": "source.nebula",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#control"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#typeAnnotations"
    },
    {
      "include": "#functionCalls"
    },
    {
      "include": "#namedArguments"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nebula",
          "match": "//[^\\r\\n]*"
        },
        {
          "name": "comment.block.nebula",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.nebula",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.nebula",
              "match": "\\\\(?:[\\\\'\\\"nrt0]|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        },
        {
          "name": "string.quoted.double.nebula",
          "begin": "\"",
          "end": "\"|(?=\\r?$)",
          "patterns": [
            {
              "name": "constant.character.escape.nebula",
              "match": "\\\\(?:[\\\\'\\\"nrt0]|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        },
        {
          "name": "string.quoted.single.nebula",
          "begin": "'",
          "end": "'|(?=\\r?$)",
          "patterns": [
            {
              "name": "constant.character.escape.nebula",
              "match": "\\\\(?:[\\\\'\\\"nrt0]|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        },
        {
          "name": "string.template.nebula",
          "begin": "`",
          "end": "`|(?=\\r?$)",
          "patterns": [
            {
              "name": "meta.interpolation.nebula",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#identifiers"
                },
                {
                  "include": "#operators"
                },
                {
                  "include": "#functionCalls"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nebula",
          "match": "(?<![\\p{XID_Continue}_])0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?![\\p{XID_Continue}_])"
        },
        {
          "name": "constant.numeric.binary.nebula",
          "match": "(?<![\\p{XID_Continue}_])0[bB][01](?:_?[01])*(?![\\p{XID_Continue}_])"
        },
        {
          "name": "constant.numeric.octal.nebula",
          "match": "(?<![\\p{XID_Continue}_])0[oO][0-7](?:_?[0-7])*(?![\\p{XID_Continue}_])"
        },
        {
          "name": "constant.numeric.decimal.nebula",
          "match": "(?<![\\p{XID_Continue}_])[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?(?![\\p{XID_Continue}_])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.nebula",
          "match": "(?<![\\\\p{XID_Continue}_])(?:sim|verdadeiro|falso)(?![\\\\p{XID_Continue}_])"
        },
        {
          "name": "constant.language.null.nebula",
          "match": "(?<![\\p{XID_Continue}_])(?:nulo)(?![\\p{XID_Continue}_])"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.name.attribute.nebula",
          "match": "@[\\p{XID_Start}_][\\p{XID_Continue}_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.variable.nebula",
          "match": "((?<![\\p{XID_Continue}_])(?:constante|variavel)(?![\\p{XID_Continue}_]))\\s+([\\p{XID_Start}_][\\p{XID_Continue}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.variable.nebula"
            },
            "2": {
              "name": "variable.other.declaration.nebula"
            }
          }
        },
        {
          "name": "meta.declaration.function.nebula",
          "match": "(?:(publico|privado|protegido|estatico|async)\\s+)*(funcao)\\s+([\\p{XID_Start}_][\\p{XID_Continue}_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.nebula"
            },
            "2": {
              "name": "storage.type.function.nebula"
            },
            "3": {
              "name": "entity.name.function.nebula"
            }
          }
        },
        {
          "name": "meta.declaration.class.nebula",
          "match": "(classe)\\s+([\\p{XID_Start}_][\\p{XID_Continue}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.nebula"
            },
            "2": {
              "name": "entity.name.type.class.nebula"
            }
          }
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.nebula",
          "match": "(?<![\\\\p{XID_Continue}_])(?:instanciaDe|construtor|privilegio|verifique|constante|protegido|enquanto|prossiga|identico|variavel|estatico|montagem|exportar|escolha|retorne|incluir|aguarda|externa|privado|publico|definir|critico|padrao|passar|funcao|lambda|classe|sempre|lancar|global|apagar|dentro|tipoDe|seguro|sendo|senao|ceder|tente|async|herda|obter|vazio|caso|para|pare|como|erro|isto|novo|fora|com|nao|de|ou|e|tipo)(?![\\\\p{XID_Continue}_])"
        },
        {
          "name": "keyword.operator.word.logical.nebula",
          "match": "(?<![\\p{XID_Continue}_])(?:identico|dentro|fora|nao|ou|e)(?![\\p{XID_Continue}_])"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.nebula",
          "match": "(?<![\\\\p{XID_Continue}_])(?:protegido|estatico|publico|privado|externa|global|async)(?![\\\\p{XID_Continue}_])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nebula",
          "match": "(?<![\\p{XID_Continue}_])(?:visualizarMemoria|escreverLinhas|diretorioAtual|listarArquivos|criarDiretorio|removerArquivo|alinhamentoDe|vetorOctetos|conImutavel|arredondar|enderecoDe|identidade|substituir|dicionario|lerLinhas|tamanhoDe|maiusculo|minusculo|localizar|lerTexto|lerLinha|escrever|potencia|inverter|enumerar|executar|complexo|conjunto|truncar|tamanho|ordenar|agrupar|filtrar|reduzir|dividir|inteiro|decimal|octetos|exibir|fechar|divres|minimo|maximo|mapear|juntar|contar|existe|logico|tipoDe|abrir|somar|faixa|texto|lista|tupla|raiz|piso|teto|ler|abs)(?![\\p{XID_Continue}_])(?=\\s*\\()"
        },
        {
          "name": "support.module.nebula",
          "match": "(?<![\\p{XID_Continue}_])(?:interrupcao|hardware|ponteiro|memoria|energia|porta|cache|tempo|bits|simd|cpu|dma)(?![\\p{XID_Continue}_])(?=\\s*\\.)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.nebula",
          "match": "(?<![\\\\p{XID_Continue}_])(?:inteiro_u128|inteiro_u64|inteiro_u32|inteiro_u16|inteiro_u8|inteiro128|inteiro64|inteiro32|inteiro16|inteiro8|decimal64|decimal32|enderecoFisico|deslocamento|caractere|complexo|endereco|inteiro|decimal|logico|texto|vazio|tamanho|byte|u128|u64|u32|u16|u8|i128|i64|i32|i16|i8|f64|f32)(?![\\\\p{XID_Continue}_])"
        },
        {
          "name": "support.type.container.nebula",
          "match": "(?<![\\p{XID_Continue}_])(?:ponteiroBruto|conImutavel|dicionario|conjunto|ponteiro|lista|tupla|vetor|bloco)(?![\\p{XID_Continue}_])"
        }
      ]
    },
    "typeAnnotations": {
      "name": "meta.type.annotation.nebula",
      "begin": ":(?!:)\\s*",
      "end": "(?=(?:,\\s*[\\p{XID_Start}_][\\p{XID_Continue}_]*\\s*:|[)=;{}\\r\\n=]))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.type-annotation.nebula"
        }
      },
      "patterns": [
        {
          "include": "#types"
        },
        {
          "name": "entity.name.type.reference.nebula",
          "match": "[\\p{XID_Start}_][\\p{XID_Continue}_]*"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "meta.function-call.nebula",
          "match": "([\\p{XID_Start}_][\\p{XID_Continue}_]*)(\\s*)(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.nebula"
            }
          }
        }
      ]
    },
    "namedArguments": {
      "patterns": [
        {
          "name": "meta.member-access.nebula",
          "match": "(?:\\.|::)\\s*([\\p{XID_Start}_][\\p{XID_Continue}_]*)",
          "captures": {
            "1": {
              "name": "variable.other.member.nebula"
            }
          }
        },
        {
          "name": "variable.parameter.argument.nebula",
          "match": "([\\p{XID_Start}_][\\p{XID_Continue}_]*)(?=\\s*=\\s*[^=])"
        },
        {
          "name": "variable.parameter.nebula",
          "match": "(?<![\\p{XID_Continue}_])([\\p{XID_Start}_][\\p{XID_Continue}_]*)(?=\\s*:)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lambda.nebula",
          "match": "->"
        },
        {
          "name": "keyword.operator.access.nebula",
          "match": "::|\\?\\.|\\."
        },
        {
          "name": "keyword.operator.range.nebula",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.nebula",
          "match": "(?:\\\\*\\\\*=|//=|\\\\?\\\\?=|\\\\+=|-=|\\\\*=|/=|%=|=|\\\\+\\\\+|--)"
        },
        {
          "name": "keyword.operator.comparison.nebula",
          "match": "!==|===|==|!=|<=|>=|<|>|iguais"
        },
        {
          "name": "keyword.operator.logical.nebula",
          "match": "&&|\\|\\||!|\\?\\?|\\?"
        },
        {
          "name": "keyword.operator.bitwise.nebula",
          "match": ">>>|<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.arithmetic.nebula",
          "match": "\\\\*\\\\*|//|[+*/%\\\\-]|\\\\\\\\"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.nebula",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.nebula",
          "match": ":"
        },
        {
          "name": "punctuation.section.group.end.nebula",
          "match": "[)}\\]>]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.nebula",
          "match": "[\\p{XID_Start}_][\\p{XID_Continue}_]*"
        }
      ]
    }
  }
}
