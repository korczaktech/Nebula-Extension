{
  "name": "nebula-language",
  "displayName": "Nebula Language Support",
  "description": "Suporte oficial à linguagem Nebula no Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "korczak-technologies",
  "author": "Korczak Technologies",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/korczaktech/Nebula-Extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/korczaktech/Nebula-Extension.git"
  },
  "bugs": {
    "url": "https://github.com/korczaktech/Nebula-Extension/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nebula",
    "nebula-language",
    "nbx",
    "korczak-technologies",
    "language-support"
  ],
  "activationEvents": [
    "onLanguage:nebula"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nebula",
        "aliases": [
          "Nebula",
          "nebula"
        ],
        "extensions": [
          ".nbx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/nebula-file.svg",
          "dark": "./icons/nebula-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nebula",
        "scopeName": "source.nebula",
        "path": "./syntaxes/nebula.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nebula",
        "path": "./snippets/nebula.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check-types": "tsc --noEmit -p ./",
    "test": "node --test",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  },
  "files": [
    "out/**",
    "syntaxes/**",
    "snippets/**",
    "icons/**",
    "language-configuration.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
