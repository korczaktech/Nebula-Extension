{
  "name": "nbx-language",
  "displayName": "Suporte à Linguagem Nebula",
  "description": "Suporte oficial à linguagem Nebula no Visual Studio Code.",
  "version": "0.0.7",
  "publisher": "KorczakTechnologiesBR",
  "author": "Korczak Technologies",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/korczaktech/Nebula-Extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/korczaktech/Nebula-Extension.git"
  },
  "bugs": {
    "url": "https://github.com/korczaktech/Nebula-Extension/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nebula",
    "nebula-language",
    "nbx",
    "korczak-technologies",
    "language-support"
  ],
  "activationEvents": [
    "onLanguage:nebula",
    "onDebugResolve:nebula"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nebula",
        "aliases": [
          "Nebula",
          "nebula"
        ],
        "extensions": [
          ".nbx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/nebula-file.svg",
          "dark": "./icons/nebula-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nebula",
        "scopeName": "source.nebula",
        "path": "./syntaxes/nebula.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nebula",
        "path": "./snippets/nebula.json"
      }
    ],
    "configurationDefaults": {
      "[nebula]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.autoIndent": "full",
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": true,
        "editor.guides.indentation": true,
        "editor.matchBrackets": "always",
        "editor.autoClosingBrackets": "languageDefined",
        "editor.autoClosingQuotes": "languageDefined",
        "editor.autoSurround": "languageDefined",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.suggest.showWords": true,
        "editor.suggestSelection": "first",
        "editor.acceptSuggestionOnEnter": "on",
        "editor.tabCompletion": "on",
        "editor.suggest.snippetsPreventQuickSuggestions": false
      }
    },
    "configuration": {
      "title": "Nebula",
      "properties": {
        "nebula.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Ativa o servidor LSP local da Nebula (padrão: ativado)."
        },
        "nebula.languageServer.serverPath": {
          "type": "string",
          "default": "",
          "description": "Caminho opcional para substituir o servidor LSP incorporado na extensão."
        },
        "nebula.languageServer.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Argumentos adicionais passados ao executável do servidor LSP."
        },
        "nebula.languageServer.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Nível de rastreamento da comunicação LSP."
        }
      }
    },
    "commands": [
      {
        "command": "nebula.run",
        "title": "Nebula: Executar arquivo atual (runtime)"
      },
      {
        "command": "nebula.compile",
        "title": "Nebula: Compilar arquivo atual"
      },
      {
        "command": "nebula.interpret",
        "title": "Nebula: Interpretar arquivo atual"
      },
      {
        "command": "nebula.stopExecution",
        "title": "Nebula: Interromper execução"
      },
      {
        "command": "nebula.restartLanguageServer",
        "title": "Nebula: Reiniciar Language Server"
      },
      {
        "command": "nebula.languageServerStatus",
        "title": "Nebula: Estado do Language Server"
      },
      {
        "command": "nebula.installLanguageServer",
        "title": "Nebula: Verificar servidor LSP incorporado"
      },
      {
        "command": "nebula.runNative",
        "title": "Nebula: Executar nativamente (experimental)"
      }
    ],
    "themes": [
      {
        "label": "Nebula Vibrante",
        "uiTheme": "vs-dark",
        "path": "./themes/nebula-vibrante-color-theme.json"
      },
      {
        "label": "Nebula Clássico",
        "uiTheme": "vs-dark",
        "path": "./themes/nebula-classico-color-theme.json"
      },
      {
        "label": "Nebula Claro",
        "uiTheme": "vs",
        "path": "./themes/nebula-claro-color-theme.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nebula.run",
          "when": "resourceLangId == nebula",
          "group": "navigation"
        }
      ]
    },
    "debuggers": [
      {
        "type": "nebula",
        "label": "Nebula",
        "languages": [
          "nebula"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Caminho do arquivo .nbx a depurar.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pausar antes da primeira instrução.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nebula",
            "request": "launch",
            "name": "Depurar arquivo Nebula",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check-types": "tsc --noEmit -p ./",
    "test": "node --test test/unit/*.test.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "check-output": "node -e \"const fs=require('node:fs'); for (const file of ['out/extension.js','out/compiler/native.js','out/commands/execution.js','out/debug/adapter.js','out/providers/completion/provider.js','out/providers/completion/engine.js','out/providers/intelligence/provider.js','out/providers/intelligence/engine.js','out/lsp/client/client.js','out/lsp/client/installer.js','out/lsp/client/configuration.js','out/lsp/client/state.js','out/lsp/protocol/capabilities.js']) fs.accessSync(file); console.log('Artefatos da extensão e LSP presentes.');\"",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:integration": "npm run compile-tests && node out-test/test/runTest.js",
    "package:ci": "vsce package --target linux-x64 --out nbx-language.vsix && node scripts/verify-vsix.mjs nbx-language.vsix",
    "test:lsp": "node scripts/test-lsp.mjs",
    "build:native": "bash scripts/build-native.sh",
    "test:debugger": "node scripts/test-debugger.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0",
    "@types/mocha": "^10.0.10",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^10.8.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
