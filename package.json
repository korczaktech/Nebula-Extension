{
  "name": "nebula-language",
  "displayName": "Nebula Language Support",
  "description": "Suporte oficial à linguagem Nebula no Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "korczak-technologies",
  "author": "Korczak Technologies",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/korczaktech/Nebula-Extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/korczaktech/Nebula-Extension.git"
  },
  "bugs": {
    "url": "https://github.com/korczaktech/Nebula-Extension/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nebula",
    "nebula-language",
    "nbx",
    "korczak-technologies",
    "language-support"
  ],
  "activationEvents": [
    "onLanguage:nebula"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nebula",
        "aliases": [
          "Nebula",
          "nebula"
        ],
        "extensions": [
          ".nbx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/nebula-file.svg",
          "dark": "./icons/nebula-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nebula",
        "scopeName": "source.nebula",
        "path": "./syntaxes/nebula.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nebula",
        "path": "./snippets/nebula.json"
      }
    ],
    "configurationDefaults": {
      "[nebula]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.autoIndent": "full",
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": true,
        "editor.guides.indentation": true,
        "editor.matchBrackets": "always",
        "editor.autoClosingBrackets": "languageDefined",
        "editor.autoClosingQuotes": "languageDefined",
        "editor.autoSurround": "languageDefined",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.suggest.showWords": true,
        "editor.suggestSelection": "first",
        "editor.acceptSuggestionOnEnter": "on",
        "editor.tabCompletion": "on",
        "editor.suggest.snippetsPreventQuickSuggestions": false
      }
    },
    "configuration": {
      "title": "Nebula",
      "properties": {
        "nebula.languageServer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Ativa a conexão com o servidor LSP externo da Nebula."
        },
        "nebula.languageServer.serverPath": {
          "type": "string",
          "default": "nebula-lsp",
          "description": "Caminho do executável do servidor Language Server da Nebula."
        },
        "nebula.languageServer.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Argumentos adicionais passados ao executável do servidor LSP."
        },
        "nebula.languageServer.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Nível de rastreamento da comunicação LSP."
        }
      }
    },
    "commands": [
      {
        "command": "nebula.restartLanguageServer",
        "title": "Nebula: Reiniciar Language Server"
      },
      {
        "command": "nebula.languageServerStatus",
        "title": "Nebula: Estado do Language Server"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check-types": "tsc --noEmit -p ./",
    "test": "node --test",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "check-output": "node -e \"const fs=require('node:fs'); for (const file of ['out/extension.js','out/providers/completion/provider.js','out/providers/completion/engine.js','out/providers/intelligence/provider.js','out/providers/intelligence/engine.js','out/lsp/client/client.js','out/lsp/client/configuration.js','out/lsp/client/state.js','out/lsp/protocol/capabilities.js']) fs.accessSync(file); console.log('Artefatos da extensão e LSP presentes.');\"",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:integration": "npm run compile-tests && node out-test/test/runTest.js",
    "package:ci": "vsce package --out nebula-language.vsix && node scripts/verify-vsix.mjs nebula-language.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0",
    "@types/mocha": "^10.0.10",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^10.8.2"
  },
  "files": [
    "out/**",
    "syntaxes/**",
    "snippets/**",
    "icons/**",
    "language-configuration.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
