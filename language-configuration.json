{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "colorizedBracketPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "/*",
      "close": "*/",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:publico|público|privado)\\s+)?(?:(?:funcao|função)\\s+.*|(?:quando|senao|senão|enquanto|durante|repetir|cada|caso)(?:\\s|$).*|(?:pulso|para)(?:\\s|\\().*)$|^.*(\\{[^}]*|\\([^)]*|\\[[^\\]]*)$",
    "decreaseIndentPattern": "^\\s*(?:[}\\])]|(?:fim|senao|senão)(?=\\s|$))(?:\\s*(?://.*)?)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^.*\\{\\s*$",
      "afterText": "^\\s*\\}\\s*$",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^.*\\{[^}]*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*(?:(?:publico|público|privado)\\s+)?(?:(?:funcao|função)\\s+.*|(?:quando|senao|senão|enquanto|durante|repetir|cada|caso)(?:\\s|$).*|(?:pulso|para)(?:\\s|\\().*)$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*/\\*.*$",
      "afterText": "^\\s*\\*/\\s*$",
      "action": {
        "indent": "indent",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^\\s*\\*(?!/).*$",
      "action": {
        "indent": "none",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^\\s*//.*$",
      "action": {
        "indent": "none",
        "appendText": "// "
      }
    }
  ]
}
