{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "autoCloseBefore": ";:.,=}])> \\n\\t",
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{[^}]*|\\([^)]*|\\[[^\\]]*)$",
    "decreaseIndentPattern": "^\\s*[}\\])]\\s*(?:$|//.*$)"
  },
  "onEnterRules": [
    {
      "beforeText": "^.*\\{\\s*$",
      "afterText": "^\\s*\\}\\s*$",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "^.*\\{[^}]*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*[}\\])]\\s*$",
      "action": { "indent": "outdent" }
    },
    {
      "beforeText": "^\\s*/\\*.*$",
      "afterText": "^\\s*\\*/\\s*$",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "^\\s*\\*(?!/).*$",
      "action": { "indent": "none", "appendText": " * " }
    },
    {
      "beforeText": "^\\s*//.*$",
      "action": { "indent": "none", "appendText": "// " }
    }
  ]
}
