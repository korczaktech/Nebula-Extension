{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "colorizedBracketPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "/*",
      "close": "*/",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:publico|privado)\\s+)?(?:funcao\\b.*|quando\\b.*|senao\\b.*|enquanto\\b.*|durante\\b.*|repetir\\b.*|cada\\b.*|pulso\\b.*|para\\b.*|caso\\b.*)$|^.*(\\{[^}]*|\\([^)]*|\\[[^\\]]*)$",
    "decreaseIndentPattern": "^\\s*(?:[}\\])]\\s*(?:$|//.*$)|(?:fim|senao)\\b.*$)"
  },
  "onEnterRules": [
    {
      "beforeText": "^.*\\{\\s*$",
      "afterText": "^\\s*\\}\\s*$",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^.*\\{[^}]*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*(?:(?:publico|privado)\\s+)?(?:funcao\\b.*|quando\\b.*|senao\\b.*|enquanto\\b.*|durante\\b.*|repetir\\b.*|cada\\b.*|pulso\\b.*|para\\b.*|caso\\b.*)$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*[}])]\\s*$",
      "action": {
        "indent": "outdent"
      }
    },
    {
      "beforeText": "^\\s*fim\\b.*$",
      "action": {
        "indent": "outdent"
      }
    },
    {
      "beforeText": "^\\s*senao\\b.*$",
      "action": {
        "indent": "outdent"
      }
    },
    {
      "beforeText": "^\\s*/\\*.*$",
      "afterText": "^\\s*\\*/\\s*$",
      "action": {
        "indent": "indent",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^\\s*\\*(?!/).*$",
      "action": {
        "indent": "none",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^\\s*//.*$",
      "action": {
        "indent": "none",
        "appendText": "// "
      }
    }
  ]
}
